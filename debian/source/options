# Ignore generated files that shouldn't be included in the source diff
extend-diff-ignore = "(^|/)\.github/"
extend-diff-ignore = "(^|/)\.gitignore$"
extend-diff-ignore = "(^|/)build-deb/"
extend-diff-ignore = "(^|/)build/"
extend-diff-ignore = "(^|/)\.venv/"
extend-diff-ignore = "(^|/)\.cache/"
extend-diff-ignore = "(^|/)\.claude/"
extend-diff-ignore = "(^|/)\.agents/"
extend-diff-ignore = "(^|/)\.aws/"
extend-diff-ignore = "(^|/)\.codex/"
extend-diff-ignore = "(^|/)\.gitnexus/"
extend-diff-ignore = "(^|/)CLAUDE\.md$"
extend-diff-ignore = "(^|/)AGENTS\.md$"
extend-diff-ignore = "(^|/)CMakeFiles/"
extend-diff-ignore = "(^|/)Testing/"
extend-diff-ignore = "(^|/)__pycache__/"
extend-diff-ignore = "\.pyc$"
extend-diff-ignore = "(^|/)compile_commands\.json$"
extend-diff-ignore = "(^|/)skey-engine/"
extend-diff-ignore = "\.deb$"
# Packaging artifacts — never let a stray .dsc/.tar.* in the tree break dpkg-source
extend-diff-ignore = "\.dsc$"
extend-diff-ignore = "\.changes$"
extend-diff-ignore = "\.buildinfo$"
extend-diff-ignore = "\.orig\.tar\..*$"
extend-diff-ignore = "\.debian\.tar\..*$"
