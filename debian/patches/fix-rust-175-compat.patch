Description: Fix Rust 1.75 compatibility — replace #[unsafe(no_mangle)] with #[no_mangle]
 The #[unsafe(no_mangle)] attribute syntax requires Rust >= 1.82, but the
 Launchpad buildd ships Rust 1.75.  Revert to the pre-1.82 syntax which
 is supported by both old and new Rust toolchains.
Author: Nguyen Tien Huy <collyn094@gmail.com>
Forwarded: not-needed

--- a/skey-engine/src/lib.rs
+++ b/skey-engine/src/lib.rs
@@ -51,7 +51,7 @@

 // ── C FFI ──────────────────────────────────────────────────────────

-#[unsafe(no_mangle)]
+#[no_mangle]
 pub unsafe extern "C" fn skey_engine_new(method: i32) -> *mut SkeyEngine {
     let m = match method {
         0 => Method::Telex,    // SKEY_METHOD_TELEX
@@ -63,12 +63,12 @@
     Box::into_raw(Box::new(SkeyEngine::new(m)))
 }

-#[unsafe(no_mangle)]
+#[no_mangle]
 pub unsafe extern "C" fn skey_engine_free(engine: *mut SkeyEngine) {
     if !engine.is_null() { unsafe { drop(Box::from_raw(engine)); } }
 }

-#[unsafe(no_mangle)]
+#[no_mangle]
