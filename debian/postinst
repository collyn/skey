#!/bin/bash
set -e

case "$1" in
    configure)
        # Update icon caches so the skey icon appears in taskbar after installation
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
            gtk-update-icon-cache /usr/share/icons/breeze 2>/dev/null || true
            gtk-update-icon-cache /usr/share/icons/breeze-dark 2>/dev/null || true
        fi

        # systemd daemon-reload for new/updated uinput service unit
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload 2>/dev/null || true
        fi

        if [ -z "$2" ]; then
            # ── First install ──
            # Run full skey-setup: configures fcitx5 profile, shell env vars,
            # KWin virtual keyboard, autostart, ibus disable, etc.
            #
            # It must run INSIDE the user's graphical session — `su -`
            # loses XDG_SESSION_TYPE / XDG_CURRENT_DESKTOP, which made the
            # KDE-Wayland blocks (KWin reconnect, session env files) silently
            # skip.  Route through the user's systemd manager instead.
            if [ -n "$SUDO_USER" ]; then
                if command -v systemd-run >/dev/null 2>&1 && \
                   systemd-run --user --machine="${SUDO_USER}@.host" \
                       --wait --pipe true 2>/dev/null; then
                    # KillMode=none: skey-setup starts fcitx5 -d, which
                    # daemonizes inside the transient unit.
                    systemd-run --user --machine="${SUDO_USER}@.host" \
                        --wait --pipe -p KillMode=none /usr/bin/skey-setup \
                        2>/dev/null || true
                else
                    su - "$SUDO_USER" -c "skey-setup" 2>/dev/null || true
                fi
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl enable --now "fcitx5-skey-uinput-server@${SUDO_USER}.service" 2>/dev/null || true
                fi
            fi
        else
            # ── Upgrade ──
            # Restart fcitx5 to load the new skey.so and gently reconnect
            # KWin's zwp_input_method_v2.  The helper script must run
            # INSIDE the user's graphical session — `su -` loses
            # XDG_SESSION_TYPE / DBUS_SESSION_BUS_ADDRESS (the reconnect
            # toggle silently never ran), so route through the user's
            # systemd manager, which carries the session environment.
            if [ -n "$SUDO_USER" ]; then
                # Restart uinput server first (picks up new binary)
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl try-restart "fcitx5-skey-uinput-server@${SUDO_USER}.service" 2>/dev/null || true
                fi
                if command -v systemd-run >/dev/null 2>&1 && \
                   systemd-run --user --machine="${SUDO_USER}@.host" \
                       --wait --pipe true 2>/dev/null; then
                    # KillMode=none: fcitx5 -r -d daemonizes inside the
                    # transient unit — default KillMode would kill it when
                    # the unit finishes.
                    systemd-run --user --machine="${SUDO_USER}@.host" \
                        --wait --pipe -p KillMode=none \
                        /usr/bin/skey-restart-fcitx5 \
                        2>/dev/null || true
                else
                    # Fallback: no user systemd manager — bare restart
                    # (apps may need a focus toggle to reconnect).
                    su - "$SUDO_USER" -c "fcitx5 -r -d 2>/dev/null" 2>/dev/null || true
                fi
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
