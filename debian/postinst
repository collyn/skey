#!/bin/bash
set -e

case "$1" in
    configure)
        # Update icon caches so the skey icon appears in taskbar after installation
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
            gtk-update-icon-cache /usr/share/icons/breeze 2>/dev/null || true
            gtk-update-icon-cache /usr/share/icons/breeze-dark 2>/dev/null || true
        fi

        /usr/bin/skey-uinput-access configure

        if [ -z "$2" ]; then
            # ── First install ──
            # User configuration is performed manually with skey-setup.
            if [ -n "$SUDO_USER" ]; then
                # im-config deliberately NOT run here: it must run as the
                # USER (it writes ~/.xinputrc, not a system file) —
                # skey-setup does it when the user runs it manually.
                # Running it as root writes the system-wide default AND
                # spawns a root-owned fcitx5 that steals the session D-Bus
                # name.  Keep this pkill as migration cleanup for machines
                # that already have such a zombie from older installs.
                pkill -u root -x fcitx5 2>/dev/null || true
            fi
        else
            # ── Upgrade ──
            # Restart fcitx5 to load the new skey.so and gently reconnect
            # KWin's zwp_input_method_v2.  The helper script must run
            # INSIDE the user's graphical session — `su -` loses
            # XDG_SESSION_TYPE / DBUS_SESSION_BUS_ADDRESS (the reconnect
            # toggle silently never ran), so route through the user's
            # systemd manager, which carries the session environment.
            # SUDO_USER is unset when the update arrives via pkexec (the
            # settings GUI updater) or a GUI package manager, which used to
            # skip the fcitx5 restart entirely.  Resolve the console user
            # through loginctl as a fallback so the restart still runs
            # inside the user's graphical session.
            CONSOLE_USER="$SUDO_USER"
            if [ -z "$CONSOLE_USER" ] && command -v loginctl >/dev/null 2>&1; then
                CONSOLE_USER=$(loginctl list-sessions --no-legend 2>/dev/null | \
                    awk '$4=="seat0" {print $3}' | sort -u | head -1)
            fi
            if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
                if command -v systemd-run >/dev/null 2>&1 && \
                   systemd-run --user --machine="${CONSOLE_USER}@.host" \
                       --wait --pipe true 2>/dev/null; then
                    # KillMode=none: fcitx5 -r -d daemonizes inside the
                    # transient unit — default KillMode would kill it when
                    # the unit finishes.
                    systemd-run --user --machine="${CONSOLE_USER}@.host" \
                        --wait --pipe -p KillMode=none \
                        /usr/bin/skey-restart-fcitx5 \
                        2>/dev/null || true
                else
                    # Fallback: no user systemd manager — bare restart
                    # (apps may need a focus toggle to reconnect).
                    # DISPLAY passthrough: `su -` resets the environment.
                    su - "$CONSOLE_USER" -c "DISPLAY='${DISPLAY:-:0}' fcitx5 -r -d 2>/dev/null" 2>/dev/null || true
                fi
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
