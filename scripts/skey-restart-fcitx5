#!/usr/bin/env bash
# Gentle fcitx5 restart — replaces the running instance and makes KWin
# reconnect its zwp_input_method_v2 without apps losing their text-input
# registration (STerm, Electron, ...).  Used by:
#   - debian/postinst + spec %post (via `systemd-run --user --machine=$USER@.host`,
#     which provides the graphical session environment from a root context)
#   - the settings GUI "Khởi động lại Fcitx5" button (config_io.cpp)
#   - scripts/dev-restart-fcitx5.sh (dev loop)
#
# Two timing requirements, both learned the hard way:
#   1. `su -` (login shell) does NOT carry XDG_SESSION_TYPE /
#      DBUS_SESSION_BUS_ADDRESS — the KWin toggle below silently never ran
#      from postinst, so apps lost the IM connection.
#   2. Toggling VirtualKeyboard before the skey addon finished registering
#      left KWin reconnected to a half-initialized IM: text-input-v3 clients
#      that never re-commit (STerm) stayed dead until the app was restarted,
#      while Chromium apps recovered on their own and masked the race.

# Redirect BOTH streams: the daemon keeps stdout/stderr open across the
# fork, and when this script runs under `systemd-run --wait --pipe`
# (postinst), an open pipe FD makes --pipe never see EOF.
fcitx5 -r -d >/dev/null 2>&1 || true

# No Wayland / no KDE Plasma → nothing to reconnect.
if [ "${XDG_SESSION_TYPE:-}" != "wayland" ]; then
    exit 0
fi
case "${XDG_CURRENT_DESKTOP:-}" in
    KDE|kde|KDE-Plasma|plasma) ;;
    *) exit 0 ;;
esac

QBUS=$(command -v qdbus6 || command -v qdbus || true)
[ -n "$QBUS" ] || exit 0

# Wait for fcitx5 to come back (max ~10s).
ready=0
for _ in $(seq 1 40); do
    if "$QBUS" org.fcitx.Fcitx5 / >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 0.25
done
# Wait for the skey addon to fully register (the last addon to load,
# ~2s after daemon start) before toggling.  A fixed 1s margin raced with
# it: toggling KWin while fcitx5 was half-initialized left text-input-v3
# clients that never re-commit (STerm) dead until app restart, while
# Chromium apps recovered on their own and masked the problem.
if [ "$ready" = 1 ]; then
    for _ in $(seq 1 40); do
        if [ -n "$("$QBUS" org.fcitx.Fcitx5 /controller \
                org.fcitx.Fcitx.Controller1.AddonForIM skey-im 2>/dev/null)" ]; then
            break
        fi
        sleep 0.25
    done
fi

# Minimal 100ms off window: short enough that apps keep their text input
# registration, long enough for KWin to tear down and re-spawn the
# fcitx5-wayland-launcher against the new instance.
"$QBUS" org.kde.KWin /VirtualKeyboard \
    org.freedesktop.DBus.Properties.Set \
    org.kde.kwin.VirtualKeyboard enabled false 2>/dev/null || true
sleep 0.1
"$QBUS" org.kde.KWin /VirtualKeyboard \
    org.freedesktop.DBus.Properties.Set \
    org.kde.kwin.VirtualKeyboard enabled true 2>/dev/null || true
