#!/bin/bash
# skey-setup: Configure fcitx5 to use skey as the default Vietnamese input method.
# Run this after installing skey: sudo make install && skey-setup
#
# Environment variables are only written when missing or wrong, and only
# after asking on a terminal (the files to modify are listed first).
# Non-interactive runs (package postinst, settings-app update flow) write
# only when needed.  Options:
#   -y, --yes       write environment variables without prompting
#   --no-env        skip all environment-variable setup (files and session)
#   -u, --uninstall remove skey configuration (env vars, fcitx5 profile
#                   entry) — only skey-guarded content is
#                   touched, the rest of each file is preserved

set -e

# CLI options
WRITE_ENV=""    # empty = decide from run context (see env section below)
UNINSTALL=0
FORCE_RESTART=0
while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) WRITE_ENV=1 ;;
        --no-env) WRITE_ENV=0 ;;
        -u|--uninstall) UNINSTALL=1 ;;
        -r|--restart) FORCE_RESTART=1 ;;
        -h|--help)
            echo "Usage: skey-setup [-y|--yes] [--no-env] [-r|--restart] [-u|--uninstall]"
            echo "  -y, --yes       Write environment variables without prompting."
            echo "  --no-env        Skip all environment-variable setup."
            echo "  -r, --restart   Always restart fcitx5 (default: only when something"
            echo "                  changed — a running fcitx5 is left alone, which"
            echo "                  also avoids the Wayland reconnect delay)."
            echo "  -u, --uninstall Remove skey configuration: environment variables,"
            echo "                  the fcitx5 profile entry."
            exit 0
            ;;
        *)
            echo "skey-setup: unknown option: $1" >&2
            echo "Usage: skey-setup [-y|--yes] [--no-env] [-r|--restart] [-u|--uninstall]" >&2
            exit 1
            ;;
    esac
    shift
done

if [ "$(id -u)" -eq 0 ]; then
    echo "Run skey-setup as your desktop user, without sudo." >&2
    exit 1
fi

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="$CONFIG_HOME/fcitx5"
PROFILE="$CONFIG_DIR/profile"
CONFIG="$CONFIG_DIR/config"

# Tracked so the fcitx5 restart can be skipped when nothing changed:
# a no-op run must not pay the Wayland reconnect delay (KWin can take
# many seconds to re-establish its input context).
PROFILE_WRITTEN=0
CONFIG_WRITTEN=0

# ── Auto-detect environment ──
detect_shell() {
    local sh
    sh=$(basename "${SHELL:-/bin/bash}")
    case "$sh" in
        zsh)  echo "zsh" ;;
        fish) echo "fish" ;;
        *)    echo "bash" ;;
    esac
}

detect_de() {
    # Hyprland, Sway, Niri: detected by their compositor socket
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then echo "Hyprland"; return; fi
    if [ -n "${SWAYSOCK:-}" ]; then echo "Sway"; return; fi
    if [ -n "${NIRI_SOCKET:-}" ]; then echo "Niri"; return; fi
    # XDG_CURRENT_DESKTOP is a colon-separated list (e.g. ubuntu:GNOME).
    # Match individual tokens so Plasma's native Wayland policy also works
    # with vendor/session prefixes, rather than forcing duplicate IM clients.
    local desktop
    local -a desktops
    IFS=: read -r -a desktops <<< "${XDG_CURRENT_DESKTOP:-}"
    for desktop in "${desktops[@]}"; do
        case "${desktop,,}" in
            kde|kde-plasma|plasma) echo "KDE Plasma"; return ;;
            gnome|gnome-classic) echo "GNOME"; return ;;
            sway) echo "Sway"; return ;;
            hyprland) echo "Hyprland"; return ;;
            niri) echo "Niri"; return ;;
            xfce|xfce4) echo "Xfce"; return ;;
            cinnamon|x-cinnamon) echo "Cinnamon"; return ;;
            mate) echo "MATE"; return ;;
            pantheon) echo "Pantheon"; return ;;
            budgie|budgie-desktop) echo "Budgie"; return ;;
            lxqt) echo "LXQt"; return ;;
            cosmic) echo "COSMIC"; return ;;
            i3) echo "i3"; return ;;
        esac
    done
    echo "${XDG_CURRENT_DESKTOP:-unknown}"
}

detect_distro() {
    local release="${1:-/etc/os-release}" id
    [ -f "$release" ] || { echo "unknown"; return; }
    local ID="" ID_LIKE=""
    . "$release"
    # Prefer the actual distribution, then its declared family. Never
    # assume an unknown distribution uses apt just because setup runs.
    for id in "$ID" $ID_LIKE; do
        case "$id" in
            fedora|rhel|centos|rocky|almalinux) echo "fedora"; return ;;
            arch|manjaro|endeavouros|artix|cachyos) echo "arch"; return ;;
            opensuse*|suse*) echo "opensuse"; return ;;
            debian|ubuntu|linuxmint|pop) echo "debian"; return ;;
            nixos|void|gentoo) echo "$id"; return ;;
        esac
    done
    echo "${ID:-unknown}"
}

is_window_manager() {
    case "$USER_DE" in i3|Sway|Hyprland|Niri) return 0 ;; *) return 1 ;; esac
}

USER_SHELL=$(detect_shell)
USER_DE=$(detect_de)
SESSION_TYPE="${XDG_SESSION_TYPE:-}"
if [ -z "$SESSION_TYPE" ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then SESSION_TYPE=wayland; else SESSION_TYPE=x11; fi
fi
DISTRO=$(detect_distro)

echo "  Shell: $USER_SHELL  DE: $USER_DE  Session: $SESSION_TYPE  Distro: $DISTRO"

BEGIN_MARKER="# >>> fcitx5-skey >>>"
END_MARKER="# <<< fcitx5-skey <<<"

# ── Helper: strip all skey blocks from a shell config file ──
# Only skey-guarded blocks are removed; the rest of the file is kept.
# A file left empty was created by skey-setup and is deleted.
backup_env_file() {
    local file="$1" backup
    [ -e "$file" ] || return 0
    backup="${XDG_STATE_HOME:-$HOME/.local/state}/skey/environment-backups/${file#/}"
    (umask 077; mkdir -p "${backup%/*}")
    cp -pL -- "$file" "${backup}.$(date +%Y%m%d-%H%M%S).$$"
}

# Compare before/after snapshots rather than assuming a filename proves ownership.
# Whole-file comparison is deliberately conservative for shared configuration:
# later user edits are retained, with the original snapshot available for review.
state_dir() {
    printf '%s/skey/session-changes/%s' "${XDG_STATE_HOME:-$HOME/.local/state}" \
        "$(printf '%s' "$1" | sha256sum | cut -d' ' -f1)"
}
state_has() { [ -f "$(state_dir "$1")/path" ]; }
state_matches() {
    local file="$1" entry="$2" name="$3"
    if [ -f "$entry/$name.absent" ]; then
        [ ! -e "$file" ] && [ ! -L "$file" ]
    else
        [ -f "$file" ] && cmp -s -- "$file" "$entry/$name" || return 1
        if [ -f "$entry/$name.mode" ]; then
            [ "$(stat -Lc '%a' -- "$file")" = "$(cat "$entry/$name.mode")" ] || return 1
            [ "$(readlink -- "$file" || true)" = "$(cat "$entry/$name.link")" ] || return 1
        fi
    fi
}
state_begin() {
    local file="$1" category="${2:-session}" entry
    entry=$(state_dir "$file")
    if [ -f "$entry/path" ]; then
        if ! state_matches "$file" "$entry" applied; then
            echo "⚠ Preserving modified file: $file (original in $entry)" >&2
            return 1
        fi
        return 0
    fi
    (umask 077; mkdir -p "$entry")
    printf '%s\n' "$file" > "$entry/path"
    printf '%s\n' "$category" > "$entry/category"
    if [ -f "$file" ]; then
        cp -pL -- "$file" "$entry/original"
        if [ "$category" = environment ] && grep -qxF "$BEGIN_MARKER" "$file" && validate_env_blocks "$file"; then
            # Uninstall must not resurrect an older SKey block after migration.
            backup_env_file "$file"
            awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
                $0 == begin { skip=1; next }
                index($0, end) > 0 { skip=0; next }
                !skip { print }
            ' "$file" > "$entry/original"
            if ! grep -q '[^[:space:]]' "$entry/original"; then
                rm -f "$entry/original"
                : > "$entry/original.absent"
            fi
        fi
    else
        : > "$entry/original.absent"
    fi
    state_done "$file"
}
state_done() {
    local file="$1" entry
    entry=$(state_dir "$file")
    rm -f -- "$entry/applied" "$entry/applied.absent" "$entry/applied.mode" "$entry/applied.link"
    if [ -f "$file" ]; then
        cp -pL -- "$file" "$entry/applied"
        stat -Lc '%a' -- "$file" > "$entry/applied.mode"
        readlink -- "$file" > "$entry/applied.link" || true
    else
        : > "$entry/applied.absent"
    fi
}
state_restore() {
    local file="$1" entry
    entry=$(state_dir "$file")
    [ -f "$entry/path" ] || return 0
    if ! state_matches "$file" "$entry" applied; then
        echo "⚠ Keeping user changes: $file (original in $entry)" >&2
        return 0
    fi
    if [ -f "$entry/original.absent" ]; then
        rm -f -- "$file"
    else
        mkdir -p "${file%/*}"
        cat "$entry/original" > "$file"
        chmod --reference="$entry/original" "$file"
    fi
    echo "✓ Restored: $file"
    if [ "$file" = "${XDG_CONFIG_HOME:-$HOME/.config}/kwinrc" ] && command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --type=method_call --dest=org.kde.KWin /KWin \
            org.kde.KWin.reconfigure >/dev/null 2>&1 || true
    fi
    rm -rf -- "$entry"
}
state_retire() {
    local file="$1" entry retained
    entry=$(state_dir "$file")
    [ -f "$entry/path" ] || return 0
    retained="${XDG_STATE_HOME:-$HOME/.local/state}/skey/retained-changes"
    (umask 077; mkdir -p "$retained")
    mv -- "$entry" "$retained/${entry##*/}.$(date +%Y%m%d-%H%M%S).$$"
}

profile_has_other_ims() {
    [ -f "$1" ] || return 1
    awk '
        /^\[/ { item=($0 ~ /^\[Groups\/[0-9]+\/Items\/[0-9]+\]$/) }
        item && /^Name=/ {
            name=substr($0, 6)
            if (name != "" && name != "skey-im" && name !~ /^keyboard-/) found=1
        }
        END { exit !found }
    ' "$1"
}

state_restore_all() {
    local entry file
    for entry in "${XDG_STATE_HOME:-$HOME/.local/state}/skey/session-changes/"*; do
        [ -f "$entry/path" ] || continue
        [ "$WRITE_ENV" != 0 ] || [ "$(cat "$entry/category")" != environment ] || continue
        IFS= read -r file < "$entry/path"
        if [ "${KEEP_FCITX_UNINSTALL:-0}" = 1 ]; then
            # Environment, autostart, addon preferences and KWin selection
            # configure the shared framework, not the SKey addon. Another
            # method may now depend on even files originally created by SKey.
            state_retire "$file"
        else
            state_restore "$file"
        fi
    done
}

edit_file() {
    local file="$1" tmp
    shift
    tmp=$(mktemp)
    if sed "$@" "$file" > "$tmp"; then
        cat "$tmp" > "$file"
    else
        rm -f "$tmp"
        return 1
    fi
    rm -f "$tmp"
}

validate_env_blocks() {
    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { if (inside) bad=1; inside=1; next }
        index($0, end) > 0 { if (!inside) bad=1; inside=0 }
        END { exit (inside || bad) ? 1 : 0 }
    ' "$1"
}

remove_shell_env() {
    local file="$1"
    [ -f "$file" ] || return 0
    grep -qxF "$BEGIN_MARKER" "$file" || return 0
    if ! validate_env_blocks "$file"; then
        echo "⚠ Unbalanced SKey markers; preserving $file. Repair the markers before rerunning setup." >&2
        return 1
    fi
    local tmpfile
    tmpfile=$(mktemp)
    awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { skip=1; next }
        index($0, end) > 0 { skip=0; next }
        !skip { print }
    ' "$file" > "$tmpfile"
    # Strip trailing blank lines left behind by the removed block
    sed -i -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmpfile" 2>/dev/null || true
    if cmp -s "$file" "$tmpfile"; then
        rm -f "$tmpfile"
        return 0
    fi
    backup_env_file "$file"
    if [ -s "$tmpfile" ]; then
        chmod --reference="$file" "$tmpfile"
        cat "$tmpfile" > "$file"
        rm -f "$tmpfile"
        echo "✓ Removed skey env block from: $file"
    else
        rm -f "$tmpfile" "$file"
        echo "✓ Removed skey-created file: $file"
    fi
}

# ── Helper: remove the obsolete system-wide profile.d script ──
# Old package versions shipped /etc/profile.d/fcitx5-skey.sh, sourced by
# every login shell and DM chain.  Under the current single-user-file
# policy it is not only redundant — it re-injects the old variable set
# into the session and the systemd user manager at every login, so the
# state detection below would report pollution on every run.  Needs root;
# try cached sudo, otherwise say exactly what to run.
remove_stale_profile_d() {
    [ -f /etc/profile.d/fcitx5-skey.sh ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        mv /etc/profile.d/fcitx5-skey.sh "/etc/profile.d/fcitx5-skey.sh.disabled-by-skey.$(date +%Y%m%d-%H%M%S).$$"
    elif command -v sudo >/dev/null 2>&1 && \
         sudo -n mv /etc/profile.d/fcitx5-skey.sh "/etc/profile.d/fcitx5-skey.sh.disabled-by-skey.$(date +%Y%m%d-%H%M%S).$$" 2>/dev/null; then
        echo "✓ Removed obsolete system file: /etc/profile.d/fcitx5-skey.sh (via sudo)"
        return 0
    else
        echo "⚠ Obsolete system file still present: /etc/profile.d/fcitx5-skey.sh"
        echo "  It re-adds old env vars at every login."
        echo "  Disable it with: sudo mv /etc/profile.d/fcitx5-skey.sh /etc/profile.d/fcitx5-skey.sh.disabled-by-skey"
        return 0
    fi
    echo "✓ Removed obsolete system file: /etc/profile.d/fcitx5-skey.sh"
}

# ── Helper: report unowned IM variables in /etc/environment ──
# A value such as fcitx/ibus is not proof that SKey wrote it. This shared
# system file is preserved, including on --no-env and uninstall.
remove_stale_system_env() {
    local file=/etc/environment
    [ -f "$file" ] || return 0
    if grep -qE '^[[:space:]]*(GTK_IM_MODULE|QT_IM_MODULES?|XMODIFIERS|SDL_IM_MODULE|GLFW_IM_MODULE)=' "$file"; then
        echo "⚠ $file contains IM variables; their ownership is unknown, so setup preserves them."
        echo "  Review these entries if they conflict with the selected session:"
        grep -nE '^[[:space:]]*(GTK_IM_MODULE|QT_IM_MODULES?|XMODIFIERS|SDL_IM_MODULE|GLFW_IM_MODULE)=' "$file"
    fi
}

# ── Helper: restore the active IM after the compositor reconnect ──
# When KWin/Mutter recreates the input context after the reconnect
# toggle, fcitx5 activates the FIRST item of the group (keyboard-us)
# instead of DefaultIM — the user would be left typing English after
# every skey-setup run.  Restore the IM that was active before the
# restart.  The new context can take a moment to appear, hence retries.
restore_im() {
    local target="${1:-skey-im}"
    local DBUS=""
    if command -v qdbus6 >/dev/null 2>&1; then DBUS="qdbus6"
    elif command -v qdbus >/dev/null 2>&1; then DBUS="qdbus"
    elif command -v gdbus >/dev/null 2>&1; then DBUS="gdbus"
    else return 0
    fi
    for _ in $(seq 1 20); do
        local cur=""
        if [ "$DBUS" = "gdbus" ]; then
            cur=$(gdbus call --session --dest org.fcitx.Fcitx5 \
                --object-path /controller \
                --method org.freedesktop.DBus.Properties.Get \
                org.fcitx.Fcitx.Controller1 CurrentInputMethod 2>/dev/null || true)
        else
            cur=$($DBUS org.fcitx.Fcitx5 /controller \
                org.fcitx.Fcitx.Controller1.CurrentInputMethod 2>/dev/null || true)
        fi
        case "$cur" in
            *"$target"*)
                echo "✓ Input method restored to $target"
                return 0
                ;;
        esac
        if [ "$DBUS" = "gdbus" ]; then
            gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
                --method org.fcitx.Fcitx.Controller1.SetCurrentIM "$target" 2>/dev/null || true
        else
            $DBUS org.fcitx.Fcitx5 /controller \
                org.fcitx.Fcitx.Controller1.SetCurrentIM "$target" 2>/dev/null || true
        fi
        sleep 0.2
    done
    echo "⚠ Could not restore input method to $target"
    echo "  Select it manually in the fcitx5 tray menu if needed."
    return 0
}

# Keep the running daemon's environment when profile edits require a stop.
# A terminal launched later may carry different IM/Wayland variables.
FCITX_ENV=()
FCITX_STOPPED=0
stop_fcitx() {
    local p pids i
    pids=$(pgrep -u "$(id -u)" -x fcitx5 || true)
    [ -n "$pids" ] || return 0
    for p in $pids; do
        if [ -r "/proc/$p/environ" ]; then
            mapfile -d '' -t FCITX_ENV < "/proc/$p/environ" || true
            break
        fi
    done
    FCITX_STOPPED=1
    kill $pids 2>/dev/null || true
    for p in $pids; do
        for ((i=0; i<50; ++i)); do
            kill -0 "$p" 2>/dev/null || break
            sleep 0.1
        done
        if kill -0 "$p" 2>/dev/null; then
            echo "⚠ Fcitx5 did not stop; configuration was not edited." >&2
            return 1
        fi
    done
}
start_fcitx() {
    if [ "${#FCITX_ENV[@]}" -gt 0 ]; then
        env -i "${FCITX_ENV[@]}" fcitx5 -d >/dev/null 2>&1
    else
        fcitx5 -d >/dev/null 2>&1
    fi
    FCITX_STOPPED=0
}
trap 'if [ "$FCITX_STOPPED" = 1 ]; then start_fcitx || true; fi' EXIT

# ── Uninstall mode ──
if [ "$UNINSTALL" = "1" ]; then
    echo "Uninstalling skey configuration..."

    # Stop before editing profile; otherwise Fcitx can save its cached profile
    # over the removal. Never touch another user's processes or sockets.
    WAS_RUNNING=0
    if grep -qE '^(Name|DefaultIM)=skey-im$' "$PROFILE" 2>/dev/null && \
       pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
        WAS_RUNNING=1
        stop_fcitx
    fi

    # Shutdown may flush methods just added in the settings UI. Decide
    # whether the shared framework is still needed from that latest file.
    KEEP_FCITX_UNINSTALL=0
    if profile_has_other_ims "$PROFILE"; then
        KEEP_FCITX_UNINSTALL=1
        echo "ℹ Other input methods still use Fcitx5; keeping shared environment, startup and compositor settings."
    fi

    if [ "$WRITE_ENV" != "0" ] && [ "$KEEP_FCITX_UNINSTALL" = 0 ]; then
        remove_stale_profile_d
        remove_stale_system_env

        # Remove only SKey-marked blocks across all previously used shells.
        for old in "$HOME/.profile" "$HOME/.xprofile" "$HOME/.bash_profile" "$HOME/.bash_login" \
                   "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.zshenv" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; do
            state_has "$old" || remove_shell_env "$old"
        done

        # Dedicated files without a journal may have been edited by the user.
        # Leave these legacy files for manual review instead of guessing ownership.
        for old in "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/fcitx5-skey.conf" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-workspace/env/fcitx5-skey.sh" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-workspace/env/skey.sh"; do
            if [ -f "$old" ] && ! state_has "$old"; then
                echo "⚠ Legacy environment file has no ownership journal; review: $old" >&2
            fi
        done
        for old in "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/ibus-daemon.desktop" \
                   "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/ibus-ui-gtk3.desktop"; do
            if [ -f "$old.disabled-by-skey" ] && [ ! -e "$old" ] && [ ! -L "$old" ]; then
                mv -- "$old.disabled-by-skey" "$old"
            fi
        done
    fi # --no-env also preserves environment files during uninstall

    # Keep the shared profile itself even if setup originally created it.
    # A matching existing snapshot can restore the user's previous default.
    if [ -f "$(state_dir "$PROFILE")/original" ]; then
        state_restore "$PROFILE"
    fi

    # Remove skey-im items from the fcitx5 profile and restore the
    # previous default when still present, otherwise another remaining IM
    # (keyboard-us fallback).
    if [ -f "$PROFILE" ]; then
        TMPPROF=$(mktemp)
        awk -v original="$(state_dir "$PROFILE")/original" '
            BEGIN {
                while ((getline line < original) > 0) {
                    if (line ~ /^\[Groups\/[0-9]+\]$/) {
                        oldgroup=line; sub(/^\[/, "", oldgroup); sub(/\]$/, "", oldgroup)
                    } else if (line ~ /^\[/) {
                        oldgroup=""
                    } else if (oldgroup != "" && line ~ /^DefaultIM=/) {
                        previous[oldgroup]=substr(line,11)
                    }
                }
                close(original)
            }
            FNR==NR {
                if (match($0, /^\[Groups\/[0-9]+\/Items\//)) {
                    group=$0; sub(/\/Items\/.*/, "", group); sub(/^\[/, "", group)
                    itemIndex=$0; sub(/^.*\/Items\//, "", itemIndex); sub(/\]$/, "", itemIndex)
                    itemIndex+=0
                    item=1; next
                }
                if ($0 ~ /^\[/) item=0
                if (item && $0 ~ /^Name=/ && $0 != "Name=skey-im") {
                    present[group, substr($0,6)]=1
                }
                if (item && $0 ~ /^Name=/ && $0 != "Name=skey-im" && (!(group in first) || itemIndex < firstIndex[group])) {
                    first[group]=substr($0,6)
                    firstIndex[group]=itemIndex
                }
                if (item && $0 ~ /^Name=/ && $0 != "Name=skey-im" && $0 !~ /^Name=keyboard-/ && (!(group in other) || itemIndex < otherIndex[group])) {
                    other[group]=substr($0,6)
                    otherIndex[group]=itemIndex
                }
                next
            }
            # Fcitx unmarshals Items as a vector: the first missing index
            # ends the list. Collect retained items, then emit each group in
            # numeric order with contiguous indices, preserving Name/Layout.
            function flush(    key, idx) {
                if (buf != "" && !drop) {
                    ++sectionCount
                    if (group ~ /^Groups\/[0-9]+\/Items\/[0-9]+$/) {
                        key=group; sub(/\/Items\/.*/, "", key)
                        idx=group; sub(/^.*\/Items\//, "", idx); idx+=0
                        itemBlock[key,idx]=buf
                        if (!(key in maxIndex) || idx > maxIndex[key]) maxIndex[key]=idx
                        itemGroup[sectionCount]=key
                    } else {
                        sectionBlock[sectionCount]=buf
                    }
                }
                buf=""; drop=0
            }
            /^\[/ {
                flush()
                group=$0; sub(/\].*/, "", group); sub(/^\[/, "", group)
            }
            /^DefaultIM=skey-im$/ {
                replacement=(group in other) ? other[group] : ((group in first) ? first[group] : "keyboard-us")
                if ((group, previous[group]) in present) replacement=previous[group]
                $0="DefaultIM=" replacement
            }
            /^Name=skey-im$/ && group ~ /^Groups\/[0-9]+\/Items\// { drop=1 }
            { buf=buf $0 "\n" }
            END {
                flush()
                for (section=1; section<=sectionCount; ++section) {
                    if (!(section in itemGroup)) {
                        printf "%s", sectionBlock[section]
                        continue
                    }
                    key=itemGroup[section]
                    if (emitted[key]++) continue
                    nextIndex=0
                    for (idx=0; idx<=maxIndex[key]; ++idx) {
                        if (!((key,idx) in itemBlock)) continue
                        body=itemBlock[key,idx]
                        sub(/^[^\n]*\n/, "", body)
                        printf "[%s/Items/%d]\n%s", key, nextIndex++, body
                    }
                }
            }
        ' "$PROFILE" "$PROFILE" > "$TMPPROF"
        if cmp -s "$PROFILE" "$TMPPROF"; then
            rm -f "$TMPPROF"
            echo "ℹ Profile has no skey-im entry"
        else
            cat "$TMPPROF" > "$PROFILE"
            rm -f "$TMPPROF"
            echo "✓ Removed skey-im from: $PROFILE"
        fi
    fi

    # A changed profile was edited surgically above. Retire its old journal
    # without restoring it, so a future installation can add SKey again.
    state_retire "$PROFILE"

    # Restore only journaled changes whose contents still match our writes.
    state_restore_all

    if [ "$WAS_RUNNING" = 1 ]; then
        start_fcitx
    fi
    echo "ℹ Log out and back in to refresh application and activation environments."

    echo ""
    echo "Done! skey configuration removed."
    echo "The skey package itself is still installed — remove it with your"
    echo "package manager if desired."
    exit 0
fi

mkdir -p "$CONFIG_DIR"
if ! grep -q '^Name=skey-im$' "$PROFILE" 2>/dev/null ||
   ! grep -q '^ActiveByDefault=True$' "$CONFIG" 2>/dev/null ||
   ! grep -q '^ShareInputState=All$' "$CONFIG" 2>/dev/null; then
    stop_fcitx
fi

# ── Write profile: skey-im as default (non-destructive) ──
# Preserve existing input methods; add skey-im only when missing.
if [ -f "$PROFILE" ] && grep -qxF "Name=skey-im" "$PROFILE" 2>/dev/null; then
    echo "✓ Profile already has skey-im, keeping existing config"
elif state_begin "$PROFILE"; then
    if [ -f "$PROFILE" ]; then
        # Profile exists but has no skey-im — add it as a new item
        # while preserving existing groups and items.
        echo "ℹ Adding skey-im to existing profile..."
        # Find the highest Items/N index and add after it
        MAX_ITEM=$(grep -oP '\[Groups/0/Items/\K\d+' "$PROFILE" | sort -n | tail -1)
        NEXT_ITEM=$((MAX_ITEM + 1))
        cat >> "$PROFILE" << ITEMEOF

[Groups/0/Items/$NEXT_ITEM]
# Name
Name=skey-im
# Layout
Layout=
ITEMEOF
        # Set as default IM
        if grep -q "^DefaultIM=" "$PROFILE"; then
            edit_file "$PROFILE" '/^\[Groups\/0\]$/,/^\[/ { s/^DefaultIM=.*/DefaultIM=skey-im/; }'
        else
            edit_file "$PROFILE" '/^\[Groups\/0\]$/,/^\[/ { /^Default Layout=/a DefaultIM=skey-im
}'
        fi
        echo "✓ skey-im added to existing profile"
        PROFILE_WRITTEN=1
    else
        # No profile exists — create a fresh one
        cat > "$PROFILE" << 'EOF'
[Groups/0]
# Group Name
Name=Default
# Layout
Default Layout=us
# Default Input Method
DefaultIM=skey-im

[Groups/0/Items/0]
# Name
Name=keyboard-us
# Layout
Layout=

[Groups/0/Items/1]
# Name
Name=skey-im
# Layout
Layout=

[GroupOrder]
0=Default
EOF
        echo "✓ Profile created with skey-im as default IM"
        PROFILE_WRITTEN=1
    fi
    state_done "$PROFILE"
fi

# ── Patch config: ActiveByDefault + ShareInputState ──
if state_begin "$CONFIG"; then
    if [ -f "$CONFIG" ]; then
        # Update existing config — only rewrite when the values differ, so
        # an up-to-date config doesn't trigger a needless fcitx5 restart.
        if grep -q '^ActiveByDefault=True$' "$CONFIG" && \
           grep -q '^ShareInputState=All$' "$CONFIG"; then
            echo "✓ Config already has ActiveByDefault=True, ShareInputState=All"
        else
            if ! grep -qxF '[Behavior]' "$CONFIG"; then
                printf '\n[Behavior]\n' >> "$CONFIG"
            fi
            edit_file "$CONFIG" 's/^ActiveByDefault=.*/ActiveByDefault=True/'
            edit_file "$CONFIG" 's/^ShareInputState=.*/ShareInputState=All/'
            # Lines missing entirely (not just wrong values)? Add them
            # under [Behavior].
            if ! grep -q '^ActiveByDefault=' "$CONFIG"; then
                edit_file "$CONFIG" '/^\[Behavior\]/a ActiveByDefault=True'
            fi
            if ! grep -q '^ShareInputState=' "$CONFIG"; then
                edit_file "$CONFIG" '/^\[Behavior\]/a ShareInputState=All'
            fi
            CONFIG_WRITTEN=1
            echo "✓ Config updated: ActiveByDefault=True, ShareInputState=All"
        fi
    else
        # Create minimal config
        cat > "$CONFIG" << 'EOF'
[Hotkey]
EnumerateWithTriggerKeys=True
EnumerateSkipFirst=False

[Hotkey/TriggerKeys]
0=Control+space

[Hotkey/AltTriggerKeys]
0=Shift_L

[Behavior]
ActiveByDefault=True
ShareInputState=All
PreeditEnabledByDefault=True
ShowInputMethodInformation=True
PreloadInputMethod=True
EOF
        CONFIG_WRITTEN=1
        echo "✓ Config created with skey defaults"
    fi

    state_done "$CONFIG"
fi

# ── Determine required environment variables ──
# On KDE Plasma Wayland, the fcitx5 wiki's recommended setup is to set
# NONE of GTK_IM_MODULE / QT_IM_MODULE / SDL_IM_MODULE: KWin implements
# text-input-v2/v3 and serves GTK, Qt and SDL apps natively through
# its native input-method connection. Forcing these makes the toolkit connect
# through a second fcitx5 frontend while KWin already serves it — the two
# input contexts fight over focus and surrounding-text updates land on
# the wrong one (Telegram lost tone marks / got downgraded to Uinput).
# Only XWayland apps (XMODIFIERS) and GLFW apps need a variable there.
#
# GNOME/Mutter has no standard input-method-v2 integration with fcitx5.
# Keep direct toolkit modules there; on other compositors these also cover
# older Qt clients without text-input-v3 support and XWayland applications.
# Use the module ID "fcitx", not the daemon name "fcitx5": modern modules
# accept both, but older/Snap GTK, Qt and SDL clients may accept only fcitx.
# im-config still needs the framework name fcitx5 (see below).
#
# QT_IM_MODULES is deliberately NOT set anywhere. Setting it to
# "wayland;fcitx" breaks Vietnamese input in Qt apps immediately after
# skey-setup because the wayland IM module overrides the fcitx5 module.
if [ "$SESSION_TYPE" = "wayland" ]; then
    case "$USER_DE" in
        "KDE Plasma")
            ENV_VARS="XMODIFIERS=@im=fcitx GLFW_IM_MODULE=ibus"
            ;;
        *)
            ENV_VARS="GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx SDL_IM_MODULE=fcitx GLFW_IM_MODULE=ibus"
            ;;
    esac
else
    ENV_VARS="GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx SDL_IM_MODULE=fcitx GLFW_IM_MODULE=ibus"
fi

# A display manager normally reads .profile. Bare compositor sessions
# started from a TTY instead inherit their login shell's configuration.
LOGIN_ENVFILE="$HOME/.profile"
if is_window_manager; then
    case "$USER_SHELL" in
        bash) LOGIN_ENVFILE="$HOME/.bash_profile" ;;
        zsh) LOGIN_ENVFILE="$HOME/.zprofile" ;;
        fish) LOGIN_ENVFILE="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish" ;;
    esac
fi
if [ "$DISTRO" = "nixos" ] && [ -z "$WRITE_ENV" ]; then
    WRITE_ENV=0
    echo "ℹ NixOS: manage session variables with i18n.inputMethod in your NixOS/Home Manager configuration."
    echo "  Use --yes only if you intentionally want user-level environment overrides."
fi

# ── Helper: safely update a shell config file ──
# Strips ALL existing fcitx5-skey blocks (dedup), then appends one fresh block.
# This guarantees exactly one block with current content, regardless of how many
# times the script runs or whether a buggy older version left duplicates.
# Arguments: $1 = file path, $2 = content (multi-line, with export prefix).
upsert_shell_env() {
    local file="$1"
    local content="$2"
    state_begin "$file" environment || return 0
    mkdir -p "${file%/*}"
    if [ -f "$file" ]; then
        if ! validate_env_blocks "$file"; then
            echo "⚠ Unbalanced SKey markers; preserving $file." >&2
            return 1
        fi
        backup_env_file "$file"
    fi
    # Creating .bash_profile changes Bash's startup search order. Preserve
    # the existing .bash_login/.profile behavior before appending our block.
    if [ "$file" = "$HOME/.bash_profile" ] && [ ! -e "$file" ]; then
        cat > "$file" <<'BASHLOGIN'
if [ -f "$HOME/.bash_login" ]; then
    . "$HOME/.bash_login"
elif [ -f "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi
BASHLOGIN
    fi

    # The end marker must land on its own line.  The fish block ends with
    # `end` and no trailing newline — appending the marker directly produced
    # `end# <<< fcitx5-skey <<<`, which fish parses as a here-string
    # redirection and refuses to load config.fish.  Strip one trailing
    # newline here; the printf below re-adds exactly one.
    content="${content%$'\n'}"

    if [ -f "$file" ]; then
        # Remove ALL existing guarded blocks (handles duplicates from any source).
        local tmpfile
        tmpfile=$(mktemp)
        # Match the end marker anywhere in the line (index > 0), not just on
        # a whole line: an older version left a mangled fish block
        # (`end# <<< fcitx5-skey <<<`).  A whole-line match would never see
        # it, so skip would stay 1 and everything after the begin marker —
        # the rest of the user's config — would be deleted on re-run.
        awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
            $0 == begin     { skip=1; next }
            index($0, end) > 0 { skip=0; next }
            !skip { print }
        ' "$file" > "$tmpfile"
        # Strip trailing blank lines to prevent accumulation across runs,
        # then append exactly one fresh block.
        sed -i -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmpfile" 2>/dev/null || true
        if [ -s "$tmpfile" ]; then
            echo "" >> "$tmpfile"
        fi
        echo "$BEGIN_MARKER" >> "$tmpfile"
        printf '%s\n' "$content" >> "$tmpfile"
        echo "$END_MARKER" >> "$tmpfile"
        cat "$tmpfile" > "$file"
        rm -f "$tmpfile"
    else
        # Create new file with just the block.
        {
            echo "$BEGIN_MARKER"
            printf '%s\n' "$content"
            echo "$END_MARKER"
        } > "$file"
    fi
    state_done "$file"
}

# ── Environment variables: detect current state first ──
# Never touch a file that already has the correct values.  When anything
# is missing or wrong, ask before writing and list every file that would
# be modified.  Non-interactive runs (package postinst via systemd-run /
# su, or the settings app's update flow) write only when needed —
# installing the package is the consent there.  -y / --no-env override.

# systemd environment.d (KEY=VALUE format, no export).
# Respected by KDE, GNOME, Sway, and most systemd-based Wayland compositors.
ENVDIR="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
ENVFILE="$ENVDIR/fcitx5-skey.conf"
ENVD_CONTENT="# fcitx5-skey"
for var in $ENV_VARS; do
    ENVD_CONTENT="${ENVD_CONTENT}
$var"
done

# Build export lines for shell configs
# Quote values containing shell metacharacters (e.g. QT_IM_MODULES=wayland;fcitx)
# so that ; is not interpreted as a command separator when sourced.
EXPORT_LINES=""
for var in $ENV_VARS; do
    name="${var%%=*}"
    value="${var#*=}"
    EXPORT_LINES="${EXPORT_LINES}export $name=\"$value\"
"
done
# Block content as stored between the markers (trailing newline stripped).
EXPORT_BLOCK="${EXPORT_LINES%$'\n'}"
LOGIN_LINES="$EXPORT_LINES"
if is_window_manager && [ "$USER_SHELL" = "fish" ]; then
    LOGIN_LINES="if status is-login"
    for var in $ENV_VARS; do
        LOGIN_LINES="${LOGIN_LINES}
    set -gx ${var%%=*} \"${var#*=}\""
    done
    LOGIN_LINES="${LOGIN_LINES}
end
"
fi
LOGIN_BLOCK="${LOGIN_LINES%$'\n'}"


# KDE Plasma: session startup scripts — the canonical place for per-session
# env vars on KDE.  Sourced by startplasma before launching kwin and apps.
# This is a dedicated file owned by skey — safe to overwrite.
KDE_ENVDIR="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-workspace/env"
KDE_ENVFILE="$KDE_ENVDIR/fcitx5-skey.sh"
KDE_CONTENT="# fcitx5-skey"
for var in $ENV_VARS; do
    name="${var%%=*}"
    value="${var#*=}"
    KDE_CONTENT="${KDE_CONTENT}
export $name=\"$value\""
done
KDE_CONTENT="${KDE_CONTENT}
unset QT_IM_MODULES
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment QT_IM_MODULES 2>/dev/null || true
fi"
if [ "$SESSION_TYPE" = "wayland" ]; then
    # KWin serves GTK, Qt and SDL apps natively via text-input-v2/v3 —
    # purge any *_IM_MODULE injected earlier in the login chain
    # (Ubuntu's im-config default sets ibus).  Sourced by startplasma
    # AFTER the Xsession/profile scripts, so the unset wins.  Without it
    # Qt apps connect through a second fcitx5 frontend and the two
    # input contexts fight over surrounding text.
    #
    # Remove these from the manager too: Plasma apps may be started by
    # systemd instead of inheriting this shell. QT_IM_MODULE must be
    # absent, not empty — Qt5 treats the empty value as an explicit module
    # request and falls back to compose instead of native Wayland input.
    # D-Bus cannot unset its activation environment, so do not publish
    # empty assignments there; stale D-Bus values need a new login.
    KDE_CONTENT="${KDE_CONTENT}
unset GTK_IM_MODULE
unset QT_IM_MODULE
unset SDL_IM_MODULE
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user unset-environment GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE 2>/dev/null || true
fi"
fi

# ── Check which files actually need writing ──
ENV_NEEDS_FIX=0
ENV_FILES_TO_WRITE=""

# guarded_block_ok: file contains exactly <content> between the markers.
guarded_block_ok() {
    local file="$1" content="$2" existing
    [ -f "$file" ] || return 1
    validate_env_blocks "$file" || return 1
    [ "$(grep -xcF "$BEGIN_MARKER" "$file")" = "1" ] || return 1
    existing=$(awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { inblock=1; next }
        index($0, end) > 0 { inblock=0; next }
        inblock { print }
    ' "$file")
    [ "$existing" = "$content" ]
}

# owned_file_ok: skey-owned file matches the expected content exactly.
# An exact match (not per-line presence) also catches stale entries an
# older version left behind (e.g. QT_IM_MODULES=wayland;fcitx).
owned_file_ok() {
    local file="$1" content="$2" existing
    [ -f "$file" ] || return 1
    existing=$(cat "$file")
    existing="${existing%$'\n'}"
    content="${content%$'\n'}"
    [ "$existing" = "$content" ]
}

# register_env_file: record a file that needs writing (if any).
register_env_file() {  # $1=path $2=expected content $3=guarded|owned
    ACTIVE_ENVFILE="$1"
    if [ "$3" = "guarded" ]; then
        guarded_block_ok "$1" "$2" && return 0
    else
        owned_file_ok "$1" "$2" && return 0
    fi
    ENV_NEEDS_FIX=1
    ENV_FILES_TO_WRITE="${ENV_FILES_TO_WRITE}    • $1
"
}

# Exactly ONE file per session context — the canonical mechanism for
# that context. Desktop sessions do not need shell rc overrides. Bare
# WMs use the login shell, including Fish's login-only config block;
# the apply block also updates future session activation.
#
#   KDE Plasma (X11 + Wayland) → ~/.config/plasma-workspace/env/*.sh
#     (sourced by startplasma before any app starts; also the only place
#     that can run the IM_MODULE unsets on Wayland)
#   Full Wayland desktop → environment.d; .profile without a user manager
#   Full X11 desktop     → ~/.profile (display manager login)
#   Bare window manager  → login shell file, including TTY-started sessions
if [ "$USER_DE" = "KDE Plasma" ]; then
    register_env_file "$KDE_ENVFILE" "$KDE_CONTENT" owned
elif [ "$SESSION_TYPE" = "wayland" ] && ! is_window_manager; then
    if command -v systemctl >/dev/null 2>&1 && \
       systemctl --user show-environment >/dev/null 2>&1; then
        register_env_file "$ENVFILE" "$ENVD_CONTENT" owned
    else
        # Non-systemd session (OpenRC/runit/…): environment.d is a
        # systemd mechanism and would be inert — fall back to .profile
        # so the display manager / login shell still picks the vars up.
        register_env_file "$LOGIN_ENVFILE" "$LOGIN_BLOCK" guarded
    fi
else
    register_env_file "$LOGIN_ENVFILE" "$LOGIN_BLOCK" guarded
fi

# Correct files do not guarantee a correct live activation environment:
# the manager may still hold fcitx5/ibus values from an older setup.
# Repair it without rewriting files that already match. On Plasma Wayland,
# toolkit variables must be absent (even an empty Qt value is incorrect).
if command -v systemctl >/dev/null 2>&1 && \
   SESSION_ENV=$(systemctl --user show-environment 2>/dev/null); then
    for var in $ENV_VARS; do
        if ! grep -Fxq -- "$var" <<< "$SESSION_ENV"; then
            ENV_NEEDS_FIX=1
        fi
    done
    if [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = "wayland" ] && \
       grep -qE '^(GTK_IM_MODULE|QT_IM_MODULE|SDL_IM_MODULE)=' <<< "$SESSION_ENV"; then
        ENV_NEEDS_FIX=1
    fi
fi

# Check every shell, including ones no longer selected by $SHELL. A
# correct primary file does not make stale secondary SKey blocks safe.
ENV_CLEANUP_FILES=()
for old in "$HOME/.profile" "$HOME/.xprofile" "$HOME/.bash_profile" "$HOME/.bash_login" \
           "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.zshenv" \
           "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; do
    [ "$old" != "$ACTIVE_ENVFILE" ] || continue
    if [ -f "$old" ] && grep -qxF "$BEGIN_MARKER" "$old"; then
        ENV_NEEDS_FIX=1
        ENV_CLEANUP_FILES+=("$old")
    fi
done
for old in "$ENVFILE" "$KDE_ENVFILE" "$KDE_ENVDIR/skey.sh"; do
    if [ "$old" != "$ACTIVE_ENVFILE" ] && [ -f "$old" ]; then
        ENV_NEEDS_FIX=1
        ENV_CLEANUP_FILES+=("$old")
    fi
done
if [ -f /etc/profile.d/fcitx5-skey.sh ]; then
    ENV_NEEDS_FIX=1
fi
if [ "${QT_IM_MODULES+x}" = x ] || \
   grep -q '^QT_IM_MODULES=' <<< "${SESSION_ENV:-}"; then
    ENV_NEEDS_FIX=1
fi
# Diagnose user-owned overrides without deleting or rewriting them. Strip
# our marked blocks from the scan so only outside declarations are reported.
for user_env in "$HOME/.profile" "$HOME/.xprofile" "$HOME/.bash_profile" "$HOME/.bash_login" \
                "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.zshenv" \
                "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish" "$ENVDIR"/*.conf; do
    [ -f "$user_env" ] || continue
    case "$user_env" in "$ENVFILE") continue ;; esac
    outside=$(awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
        $0 == begin { skip=1; next }
        index($0, end) > 0 { skip=0; next }
        !skip { print }
    ' "$user_env" | grep -E '^[[:space:]]*((export[[:space:]]+)?(GTK_IM_MODULE|QT_IM_MODULES?|SDL_IM_MODULE|GLFW_IM_MODULE|XMODIFIERS)=|set[[:space:]]+-[[:alpha:]]+[[:space:]]+(GTK_IM_MODULE|QT_IM_MODULES?|SDL_IM_MODULE|GLFW_IM_MODULE|XMODIFIERS)[[:space:]])' || true)
    if [ -n "$outside" ]; then
        echo "⚠ Unmarked IM settings in $user_env are preserved; review them if input still conflicts."
    fi
done
# Shared unmarked system configuration is advisory, never inferred to be
# SKey-owned merely from the variable value.
remove_stale_system_env

# ── Decide: ask for consent, or act on flags / run context ──
if [ "$ENV_NEEDS_FIX" = "0" ]; then
    echo "✓ Environment variables already configured correctly — no changes"
    # Correct state needs no touching — overrides -y as well.  The
    # session-env apply below is also skipped (there is nothing to apply).
    WRITE_ENV=0
elif [ -z "$WRITE_ENV" ]; then
    echo ""
    echo "ℹ Environment variables for fcitx5 are missing or outdated on this system."
    echo "  (Outdated = an older skey-setup wrote extra variables this version"
    echo "  no longer sets, e.g. GTK_IM_MODULE / QT_IM_MODULE / SDL_IM_MODULE"
    echo "  on KDE Plasma Wayland.)"
    if [ "${#ENV_CLEANUP_FILES[@]}" -gt 0 ]; then
        echo "  Obsolete SKey blocks/files to back up and remove:"
        printf '    • %s\n' "${ENV_CLEANUP_FILES[@]}"
    fi
    if [ -n "$ENV_FILES_TO_WRITE" ]; then
        echo "  skey-setup would write them to:"
        printf '%s' "$ENV_FILES_TO_WRITE"
    else
        echo "  No files need changing — only the live session would be updated"
        echo "  (repair the systemd user environment for this session)."
    fi
    if [ -t 0 ]; then
        read -r -p "  Write environment variables now? [y/N] " ANSWER || true
        case "$ANSWER" in
            y|Y|yes|YES|Yes) WRITE_ENV=1 ;;
            *) WRITE_ENV=0 ;;
        esac
    else
        # Non-interactive run (package postinst via systemd-run/su, or the
        # settings app's update flow): installing the package is the
        # consent.  This branch only runs when something is wrong —
        # repeated runs on a correct machine never write anything.
        WRITE_ENV=1
        echo "  (non-interactive run — writing; pass --no-env to skip)"
    fi
fi

# ── Write environment files (only with consent / flags) ──
# File writes additionally require that at least one file actually needs
# it: when only the live session is polluted (KDE Plasma Wayland), the
# files are left untouched and only the session is fixed further down.
if [ "$WRITE_ENV" = "1" ] && [ -n "$ENV_FILES_TO_WRITE" ]; then
    ENV_FILES_WRITTEN=""

    if [ "$USER_DE" = "KDE Plasma" ]; then
        mkdir -p "$KDE_ENVDIR"
        if state_begin "$KDE_ENVFILE" environment; then
            backup_env_file "$KDE_ENVFILE"
            printf '%s\n' "$KDE_CONTENT" > "$KDE_ENVFILE"
            chmod +x "$KDE_ENVFILE"
            state_done "$KDE_ENVFILE"
            ENV_FILES_WRITTEN="    • $KDE_ENVFILE
"
            echo "✓ KDE session env: $KDE_ENVFILE"
        fi
    elif [ "$SESSION_TYPE" = "wayland" ] && ! is_window_manager; then
        if command -v systemctl >/dev/null 2>&1 && \
           systemctl --user show-environment >/dev/null 2>&1; then
            mkdir -p "$ENVDIR"
            if state_begin "$ENVFILE" environment; then
                backup_env_file "$ENVFILE"
                printf '%s\n' "$ENVD_CONTENT" > "$ENVFILE"
                state_done "$ENVFILE"
                ENV_FILES_WRITTEN="    • $ENVFILE
"
                echo "✓ systemd environment.d: $ENVFILE"
            fi
        else
            # Non-systemd session: environment.d is inert, use .profile.
            upsert_shell_env "$LOGIN_ENVFILE" "$LOGIN_LINES"
            ENV_FILES_WRITTEN="    • $LOGIN_ENVFILE
"
            echo "✓ Login profile: $LOGIN_ENVFILE (no systemd user session)"
        fi
    else
        upsert_shell_env "$LOGIN_ENVFILE" "$LOGIN_LINES"
        ENV_FILES_WRITTEN="    • $LOGIN_ENVFILE
"
        echo "✓ Login profile: $LOGIN_ENVFILE"
    fi

    echo ""
    echo "✓ Environment variables were written to:"
    printf '%s' "$ENV_FILES_WRITTEN"
elif [ "$WRITE_ENV" != "1" ] && [ "$ENV_NEEDS_FIX" = "1" ]; then
    # Declined (prompt or --no-env) while something actually needs fixing.
    # Show exactly how to do it by hand for this session context.
    echo "ℹ Skipping environment variable setup — Vietnamese input may not"
    echo "  work in some apps until the variables are configured."
    if [ -n "$ENV_FILES_TO_WRITE" ]; then
        echo ""
        echo "  To set them yourself:"
        if [ "$USER_DE" = "KDE Plasma" ]; then
            echo "    1. Create $KDE_ENVFILE with:"
            printf '%s\n' "$KDE_CONTENT" | sed 's/^/         /'
            echo "    2. chmod +x $KDE_ENVFILE"
        elif [ "$SESSION_TYPE" = "wayland" ] && ! is_window_manager && \
             command -v systemctl >/dev/null 2>&1 && \
             systemctl --user show-environment >/dev/null 2>&1; then
            echo "    1. mkdir -p ${ENVFILE%/*}"
            echo "    2. Create $ENVFILE with:"
            printf '%s\n' "$ENVD_CONTENT" | sed 's/^/         /'
        else
            echo "    1. Append to $LOGIN_ENVFILE:"
            printf '%s\n' "$LOGIN_LINES" | sed 's/^/         /'
        fi
        echo "    3. Log out and back in."
    else
        echo ""
        echo "  No files need changing — only the live session. To fix it now:"
        if [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = "wayland" ]; then
            echo "    systemctl --user unset-environment GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE"
        fi
        echo "    systemctl --user set-environment $ENV_VARS"
    fi
    echo ""
    echo "  Or re-run skey-setup and accept the prompt to configure them."
fi

# ── Clean obsolete SKey environment only after environment authorization ──
if [ "$WRITE_ENV" = "1" ]; then
    for old in "${ENV_CLEANUP_FILES[@]}"; do
        if state_has "$old" && ! state_matches "$old" "$(state_dir "$old")" applied; then
            echo "⚠ Preserving modified legacy file: $old" >&2
            continue
        fi
        case "$old" in
            "$ENVFILE"|"$KDE_ENVFILE"|"$KDE_ENVDIR/skey.sh")
                backup_env_file "$old"
                rm -f -- "$old"
                ;;
            *) remove_shell_env "$old" ;;
        esac
        if state_has "$old"; then state_done "$old"; fi
    done
    remove_stale_profile_d
fi

# ── Stop ibus if it's running ──
# On Ubuntu and many distros, ibus is the default IM and conflicts with
# fcitx5. We stop it cleanly and prevent it from restarting so the user
# doesn't have to manually disable it.
if pgrep -u "$(id -u)" -x ibus-daemon > /dev/null 2>&1; then
    echo "→ Stopping ibus (default IM on this system)..."
    ibus exit 2>/dev/null || true

    # Wait for graceful shutdown (up to 3s)
    for i in $(seq 1 30); do
        if ! pgrep -u "$(id -u)" -x ibus-daemon > /dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done

    # Force-kill any remaining ibus processes
    if pgrep -u "$(id -u)" -x ibus-daemon > /dev/null 2>&1; then
        pkill -u "$(id -u)" -x ibus-daemon 2>/dev/null || true
        sleep 0.5
    fi

    # im-config selects the framework on next login. Do not permanently
    # disable services or rename user autostarts belonging to another IM.
    echo "✓ ibus stopped for this session"

fi

# Debian/Ubuntu select the framework via the per-user im-config API.
# Older releases expose -w rather than -n. Treat .xinputrc as an environment
# change: --no-env skips it and uninstall restores its previous contents.
if [ "$WRITE_ENV" = 1 ] && [ "$DISTRO" = "debian" ] && command -v im-config >/dev/null 2>&1; then
    if state_begin "$HOME/.xinputrc" environment; then
        if im-config -n fcitx5 2>/dev/null || im-config -w fcitx5 2>/dev/null; then
            echo "✓ im-config set to fcitx5"
        else
            echo "⚠ im-config could not set fcitx5"
        fi
        state_done "$HOME/.xinputrc"
    fi
fi

# Plasma Wayland requires KWin to launch Fcitx with its privileged IM
# socket. An ordinary XDG autostart is insufficient for native clients.
if [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = wayland ]; then
    KWRITE=$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)
    KWINRC="${XDG_CONFIG_HOME:-$HOME/.config}/kwinrc"
    FCITX_DESKTOP=""
    IFS=: read -r -a DATA_DIRS <<< "${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for appdir in "${DATA_DIRS[@]}"; do
        if [ -f "$appdir/applications/org.fcitx.Fcitx5.desktop" ]; then
            FCITX_DESKTOP="$appdir/applications/org.fcitx.Fcitx5.desktop"
            break
        fi
    done
    if [ -n "$KWRITE" ] && [ -n "$FCITX_DESKTOP" ]; then
        if state_begin "$KWINRC"; then
            "$KWRITE" --file "$KWINRC" --group Wayland --key InputMethod --type path "$FCITX_DESKTOP"
            state_done "$KWINRC"
            if command -v dbus-send >/dev/null 2>&1; then
                dbus-send --session --type=method_call --dest=org.kde.KWin /KWin \
                    org.kde.KWin.reconfigure >/dev/null 2>&1 || true
            fi
            echo "✓ KWin input method: $FCITX_DESKTOP"
        fi
    else
        echo "⚠ Select Fcitx 5 in System Settings → Virtual Keyboard (KWin configuration tools or desktop entry missing)."
    fi
fi

# ── Restart fcitx5 FIRST before touching session environment ──
# systemd set-environment and dbus-update-activation-environment can
# briefly disrupt D-Bus service registration.  Restart fcitx5 while
# the session environment is stable, then update env vars afterwards.
#
# A restart only happens when something actually changed (profile,
# config) or with -r: restarting an up-to-date daemon forces the
# Wayland compositor reconnect, which can take many seconds — a no-op
# run should stay fast.
DID_RESTART=0
NEED_RESTART=0
if pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
    if [ "$FORCE_RESTART" = 1 ] || [ "$PROFILE_WRITTEN" = 1 ] || [ "$CONFIG_WRITTEN" = 1 ]; then
        NEED_RESTART=1
        # Controller.Restart inherits the existing daemon's session environment.
        # Fall back to a scoped stop/start if the controller is unavailable.
        if command -v dbus-send >/dev/null 2>&1 && dbus-send --session --print-reply \
            --dest=org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1.Restart >/dev/null 2>&1; then
            DID_RESTART=1
        else
            stop_fcitx
            start_fcitx
            DID_RESTART=1
        fi
    else
        echo "✓ fcitx5 already running — configuration unchanged, skipping restart"
    fi
else
    NEED_RESTART=1
    DID_RESTART=1
    start_fcitx
fi

# Short early liveness poll only.  On Wayland, state 0 does NOT mean the
# daemon is down: the controller reports NoState until the compositor
# reconnects via the compositor input-method connection, and that reconnect toggle happens
# further down — a long poll here is pure waste.  On X11 a focused
# window yields state 2 immediately.  The real readiness verdict is
# given at the end of the script, after the reconnect steps.
# fcitx5-remote returns 2 when active, 1 when inactive, 0 when no input
# context exists (or the daemon is down).
READY=0
EARLY_POLLS=15
[ "$SESSION_TYPE" = "wayland" ] && EARLY_POLLS=5
[ "$NEED_RESTART" = "1" ] || EARLY_POLLS=1
for i in $(seq 1 $EARLY_POLLS); do
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        # No session bus in this context (e.g. a `su -` packaging run):
        # fcitx5-remote cannot work at all, so liveness of our daemon is
        # the best signal available.
        if pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
            READY=1
        fi
        break
    fi
    STATE=$(fcitx5-remote 2>/dev/null || echo "0")
    if [ "$STATE" = "2" ]; then
        READY=1
        break
    fi
    if [ "$SESSION_TYPE" = "wayland" ] && [ "$STATE" = "1" ]; then
        # Wayland: state 2 (focused input context) cannot happen until
        # the compositor reconnects via the compositor input-method connection — the
        # reconnect toggle further down does exactly that.  State 1
        # (daemon up and reachable on the bus) is the best early signal.
        READY=1
        break
    fi
    if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
        # OUR daemon died right after start (e.g. DISPLAY lost through
        # `su -`, or a root-owned fcitx5 still holding the D-Bus name) —
        # stop waiting.
        break
    fi
    sleep 0.2
done

# ── Ensure fcitx5 starts automatically on login ──
# Full desktops use XDG autostart: GNOME, KDE Plasma, Xfce, Cinnamon,
# MATE, Pantheon, Budgie, LXQt and COSMIC. Bare WMs are handled separately.
AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
if ! is_window_manager && ! { [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = wayland ]; }; then
    # Match the system desktop ID. Different IDs launch duplicate daemons.
    HAS_AUTOSTART=0
    IFS=: read -r -a AUTOSTART_CONFIG_DIRS <<< "${XDG_CONFIG_DIRS:-/etc/xdg}"
    for desktop_id in org.fcitx.Fcitx5.desktop fcitx5.desktop; do
        for configdir in "${XDG_CONFIG_HOME:-$HOME/.config}" "${AUTOSTART_CONFIG_DIRS[@]}"; do
            if [ -f "$configdir/autostart/$desktop_id" ]; then
                HAS_AUTOSTART=1
            fi
        done
    done
    if [ "$HAS_AUTOSTART" = 0 ]; then
        target="$AUTOSTART_DIR/org.fcitx.Fcitx5.desktop"
        if state_begin "$target"; then
            mkdir -p "$AUTOSTART_DIR"
            cat > "$target" <<'AUTOSTARTEOF'
[Desktop Entry]
Name=Fcitx 5
Exec=fcitx5 -d
Icon=fcitx5
Terminal=false
Type=Application
AUTOSTARTEOF
            state_done "$target"
            echo "✓ Fcitx5 autostart enabled: $target"
        fi
    fi
fi

# ── Window managers: ensure fcitx5 autostart ──
# XDG autostart doesn't apply to bare window managers (Sway, i3,
# Hyprland, Niri) — add the launch line to the WM config instead.
# Only APPEND the missing line; existing config content is never touched.
WM_AUTOSTART=""
case "$USER_DE" in
    Sway)
        WM_AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/sway/config"
        WM_LINE='exec --no-startup-id fcitx5 -d'
        ;;
    Hyprland)
        if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua" ] && [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf" ]; then
            WM_AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
            WM_LINE='hl.exec_cmd("fcitx5 -d")'
        else
            WM_AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"
            WM_LINE='exec-once = fcitx5 -d'
        fi
        ;;
    Niri)
        WM_AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/niri/config.kdl"
        WM_LINE='spawn-at-startup "fcitx5" "-d"'
        ;;
    i3)
        WM_AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/i3/config"
        WM_LINE='exec --no-startup-id fcitx5 -d'
        ;;
esac
if [ -n "$WM_AUTOSTART" ] && state_begin "$WM_AUTOSTART"; then
    if [ "$USER_DE" = "Niri" ] && [ -f "$WM_AUTOSTART" ] && \
       grep -qxF 'spawn-at-startup "fcitx5 -d"' "$WM_AUTOSTART"; then
        edit_file "$WM_AUTOSTART" '/^spawn-at-startup "fcitx5 -d"$/d'
    fi
    if [ -f "$WM_AUTOSTART" ] && grep -qF "$WM_LINE" "$WM_AUTOSTART" 2>/dev/null; then
        echo "✓ fcitx5 autostart already in: $WM_AUTOSTART"
    else
        mkdir -p "$(dirname "$WM_AUTOSTART")"
        [ -f "$WM_AUTOSTART" ] || : > "$WM_AUTOSTART"
        printf '\n%s\n' "$WM_LINE" >> "$WM_AUTOSTART"
        echo "✓ fcitx5 autostart added to: $WM_AUTOSTART"
    fi
    state_done "$WM_AUTOSTART"
fi

# ── Now update session environment ──
# fcitx5 is confirmed running before we touch env vars.  Only when env
# setup was consented to — never on a machine whose files were already
# correct (that state needs no touching) or where the user declined.
if [ "$WRITE_ENV" = "1" ]; then
    unset QT_IM_MODULES
    if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user unset-environment QT_IM_MODULES 2>/dev/null || true
    fi
    # Export in this setup process; parent shells and running apps retain
    # their inherited environment until restarted or a new login.
    for var in $ENV_VARS; do
        export "${var%%=*}=${var#*=}"
    done
    if [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = "wayland" ]; then
        unset GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE
    fi
    echo "✓ Env vars set for setup process"

    # systemd user session — the most reliable method for systemd-based
    # compositors (KDE, GNOME, Sway). Applies to future manager-launched
    # processes; the login files above persist it across sessions.
    if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        for var in $ENV_VARS; do
            name="${var%%=*}"
            value="${var#*=}"
            systemctl --user set-environment "$name=$value" 2>/dev/null || true
        done
        # KDE Plasma Wayland: purge any stale GTK_IM_MODULE /
        # QT_IM_MODULE / SDL_IM_MODULE injected by the distro's im-config
        # default (Ubuntu: ibus) or an old skey-setup version.  KWin's
        # native input-method integration already serves these toolkits — any
        # of the variables makes the app connect through a second fcitx5
        # frontend and the two input contexts fight over focus
        # (Telegram lost tone marks / got downgraded to Uinput).
        if [ "$USER_DE" = "KDE Plasma" ] && [ "$SESSION_TYPE" = "wayland" ]; then
            # Do not replace removal with empty assignments: Qt5 needs
            # QT_IM_MODULE to be absent for native Wayland input.
            systemctl --user unset-environment \
                GTK_IM_MODULE QT_IM_MODULE SDL_IM_MODULE \
                2>/dev/null || true
        fi
        echo "✓ systemd user environment set"
    fi

    # Update future D-Bus-activated processes too. This cannot change the
    # environment of an existing GNOME Shell, terminal or application.
    # A fresh login is needed for consistent application launching.
    # dbus-update-activation-environment is part of dbus-user-session.
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        for var in $ENV_VARS; do
            name="${var%%=*}"
            value="${var#*=}"
            export "$name=$value"
        done
        DBUS_ENV_ARGS=()
        if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
            DBUS_ENV_ARGS+=(--systemd)
        fi
        dbus-update-activation-environment "${DBUS_ENV_ARGS[@]}" $ENV_VARS 2>/dev/null || true
        echo "✓ D-Bus activation environment updated"
    fi
    echo "ℹ Log out and back in so all launchers and applications use the new environment."
fi

# ── Wayland: disable classicui (XEmbed tray broken on Wayland) ──
if [ "$SESSION_TYPE" = "wayland" ]; then
    ADDON_DIR="$CONFIG_DIR/addon"
    mkdir -p "$ADDON_DIR"
    if state_begin "$ADDON_DIR/classicui.conf"; then
        cat > "$ADDON_DIR/classicui.conf" << 'CLASSICUIOFF'
[Addon]
Enabled=False
CLASSICUIOFF
        state_done "$ADDON_DIR/classicui.conf"
        echo "✓ Disabled classicui (XEmbed tray doesn't work on Wayland)"
    fi

    # Ensure notificationitem is enabled for native SNI tray
    if state_begin "$ADDON_DIR/notificationitem.conf"; then
        cat > "$ADDON_DIR/notificationitem.conf" << 'SNION'
[Addon]
Enabled=True
SNION
        state_done "$ADDON_DIR/notificationitem.conf"
        echo "✓ Ensured notificationitem (native SNI tray) is enabled"
    fi
fi

# ── Wayland: re-trigger compositor virtual keyboard binding ──
# On Plasma Wayland, KWin connects directly via zwp_input_method_v1.
# GNOME/Cinnamon/Budgie instead use their IBus/input-source integration.
# When fcitx5 restarts, KWin may not automatically reconnect and its
# virtual keyboard silently falls back to
# "None", breaking Vietnamese input until the user manually re-selects
# fcitx5 in system settings.  We fix this by toggling KWin's VirtualKeyboard
# enabled property via D-Bus, which forces a protocol reconnect.
#
# The toggle uses a minimal 100ms off window — long enough for KWin to
# tear down and re-establish its input-method connection, but
# short enough that most apps don't notice the IM was gone and keep
# their text input registration intact.
#
# Only relevant when fcitx5 was actually restarted above: on a no-op run
# the compositor connection is untouched and must stay that way (this
# whole dance is what made repeated runs slow).
if [ "$DID_RESTART" = "1" ] && [ "$SESSION_TYPE" = "wayland" ]; then
        case "$USER_DE" in
            "KDE Plasma")
                QDBUS="qdbus6"
                if ! command -v qdbus6 >/dev/null 2>&1; then
                    QDBUS="qdbus"  # fallback for Plasma 5
                fi
                # Wait for the skey addon to fully register (the last addon
                # to load, ~2s after daemon start) before forcing KWin to
                # reconnect.  Toggling too early reconnects the IM while
                # fcitx5 is still half-initialized: text-input-v3 clients
                # that never re-commit (STerm, ...) stay dead until the app
                # is restarted, while Chromium apps recover on their own and
                # mask the race.
                if [ -z "$($QDBUS org.fcitx.Fcitx5 /controller \
                        org.fcitx.Fcitx.Controller1.AddonForIM skey-im 2>/dev/null)" ]; then
                    # The skey engine is the last addon to load and can
                    # take up to ~10s — say so, otherwise this wait looks
                    # like a hang.
                    echo "→ Waiting for the skey addon to load..."
                fi
                for _ in $(seq 1 40); do
                    if [ -n "$($QDBUS org.fcitx.Fcitx5 /controller \
                            org.fcitx.Fcitx.Controller1.AddonForIM skey-im 2>/dev/null)" ]; then
                        break
                    fi
                    sleep 0.25
                done
                $QDBUS org.kde.KWin /VirtualKeyboard org.freedesktop.DBus.Properties.Set \
                    org.kde.kwin.VirtualKeyboard enabled false 2>/dev/null || true
                sleep 0.1
                $QDBUS org.kde.KWin /VirtualKeyboard org.freedesktop.DBus.Properties.Set \
                    org.kde.kwin.VirtualKeyboard enabled true 2>/dev/null || true
                echo "✓ KWin virtual keyboard reconnected to fcitx5"
                # KWin re-establishes its input context asynchronously —
                # sometimes it takes several seconds (the focused app must
                # re-register its text input first), and occasionally the
                # first toggle races it.  Wait for the context to actually
                # appear, re-toggling when needed, BEFORE restoring the IM
                # (which needs the context to exist).
                for _ in $(seq 1 20); do
                    [ -n "$($QDBUS org.fcitx.Fcitx5 /controller \
                            org.fcitx.Fcitx.Controller1.CurrentInputMethod 2>/dev/null)" ] && break
                    $QDBUS org.kde.KWin /VirtualKeyboard org.freedesktop.DBus.Properties.Set \
                        org.kde.kwin.VirtualKeyboard enabled false 2>/dev/null || true
                    sleep 0.1
                    $QDBUS org.kde.KWin /VirtualKeyboard org.freedesktop.DBus.Properties.Set \
                        org.kde.kwin.VirtualKeyboard enabled true 2>/dev/null || true
                    sleep 0.5
                done
                restore_im "${PREV_IM:-skey-im}"
                ;;
            GNOME|Cinnamon|Budgie)
                # GNOME Shell / Cinnamon: re-apply input sources to force
                # the shell's IBus input-source integration to refresh.
                # Cinnamon uses the same gsettings schema as GNOME.
                if command -v gsettings >/dev/null 2>&1; then
                    CURRENT_SRC=$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || true)
                    if [ -n "$CURRENT_SRC" ] && [ "$CURRENT_SRC" != "@as []" ]; then
                        # Minimal dead zone (100ms) — same principle as KDE:
                        # long enough for the compositor to cycle, short enough
                        # that apps don't deregister their text input.
                        gsettings set org.gnome.desktop.input-sources sources "[]" 2>/dev/null || true
                        sleep 0.1
                        gsettings set org.gnome.desktop.input-sources sources "$CURRENT_SRC" 2>/dev/null || true
                        echo "✓ GNOME/Cinnamon input sources refreshed"
                        restore_im "${PREV_IM:-skey-im}"
                    fi
                fi
                ;;
            *)
                echo "ℹ $USER_DE Wayland: restart affected applications if they do not reconnect."
                case "$USER_DE" in
                    Sway) echo "  Native Wayland IM integration requires Sway 1.10 or later." ;;
                    Niri) echo "  Enable xwayland-satellite for X11 applications." ;;
                esac
                ;;
        esac
    fi

# ── Final readiness check ──
# Given here, after the compositor reconnect steps above: by now the
# skey addon has had time to load and the controller is on the bus, so
# this passes instantly on a healthy machine.  Still not ready here is
# a real problem worth the warning.  Skipped on no-op runs — the daemon
# was left untouched.
if [ "$DID_RESTART" = "1" ]; then
    if [ "$READY" != "1" ]; then
        echo "→ Waiting for fcitx5 to be ready..."
        for i in $(seq 1 50); do
            if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
                if pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
                    READY=1
                fi
                break
            fi
            STATE=$(fcitx5-remote 2>/dev/null || echo "0")
            if [ "$STATE" = "2" ] || { [ "$SESSION_TYPE" = "wayland" ] && [ "$STATE" = "1" ]; }; then
                READY=1
                break
            fi
            if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
        done
    fi

    if [ "$READY" = "1" ]; then
        echo "✓ fcitx5 started and active"
    else
        echo "⚠ WARNING: fcitx5 may not be fully ready yet."
        echo "  If input is not working, run: fcitx5 -r -d"
        if ! pgrep -u "$(id -u)" -x fcitx5 >/dev/null 2>&1; then
            echo "  (fcitx5 process exited immediately — X11 session: check DISPLAY)"
        fi
    fi
fi

# Uinput belongs to fcitx5. Packages load the module and grant uaccess.
if [ -w /dev/uinput ]; then
    echo "✓ /dev/uinput is accessible; Uinput starts inside fcitx5"
else
    echo "⚠ /dev/uinput is not accessible in this session"
    echo "  Check the active local seat ACL: getfacl /dev/uinput"
    echo "  Retry device setup/migration: sudo skey-uinput-access configure"
fi

# ── Icon: ensure visible in the current icon theme ──
# Some third-party themes (Vivid-Glassy-Dark, etc.) lack an index.theme
# and don't inherit hicolor, so fcitx5 and the taskbar can't find the
# skey icon.  Copy the PNG into the current theme's status + apps dirs.
if [ -f /usr/share/pixmaps/fcitx-skey.svg ]; then
    # Find icon source directory (candidate search across common icon themes)
    ICON_SRC=""
    for candidate in \
        /usr/share/icons/hicolor/scalable \
        /usr/share/icons/breeze \
        /usr/share/icons/breeze-dark \
        /usr/share/pixmaps; do
        if [ -f "$candidate/status/fcitx-skey.svg" ] || [ -f "$candidate/apps/fcitx-skey.svg" ] || [ -f "$candidate/fcitx-skey.svg" ]; then
            ICON_SRC="$candidate"
            break
        fi
    done
    # Fallback while preserving the existing source structure
    [ -z "$ICON_SRC" ] && ICON_SRC="/usr/share/icons/hicolor/scalable"

    # Detect the REAL user's icon theme (not root's when running via sudo).
    THEME_USER="${SUDO_USER:-$USER}"
    CURRENT_THEME=""
    # KDE
    THEME_HOME=$(eval echo ~"$THEME_USER")
    if [ -f "$THEME_HOME/.config/kdeglobals" ]; then
        CURRENT_THEME=$(grep -Po '^Theme=\K.*' "$THEME_HOME/.config/kdeglobals" 2>/dev/null || true)
    fi
    # GTK / fallback
    if [ -z "$CURRENT_THEME" ] && command -v gsettings >/dev/null 2>&1; then
        if [ "$(id -un 2>/dev/null)" = "$THEME_USER" ]; then
            # Already running as the user — no su.  A login-shell `su -` to
            # the SAME user blocks on stdin in packaging contexts (PAM /
            # dotfiles), stalling skey-setup right after the uinput step.
            CURRENT_THEME=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'" || true)
        else
            CURRENT_THEME=$(su - "$THEME_USER" -c "gsettings get org.gnome.desktop.interface icon-theme" 2>/dev/null | tr -d "'" || true)
        fi
    fi
    # Theme may be system-wide or user-local (~/.local/share/icons/)
    for ICONS_BASE in "/usr/share/icons" "$THEME_HOME/.local/share/icons"; do
        if [ -n "$CURRENT_THEME" ] && [ -d "$ICONS_BASE/$CURRENT_THEME" ]; then
            # Install SVG to all common status (tray) sizes
            for size in 22 24 "24@2x" "24@3x" 32; do
                mkdir -p "$ICONS_BASE/$CURRENT_THEME/status/$size" 2>/dev/null || continue
                cp "$ICON_SRC"/status/fcitx-skey.svg \
                   "$ICONS_BASE/$CURRENT_THEME/status/$size/fcitx-skey.svg" 2>/dev/null || true
            done
            # Install SVG to all common apps sizes
            for size in 32 48 "48@2x" 128; do
                mkdir -p "$ICONS_BASE/$CURRENT_THEME/apps/$size" 2>/dev/null || continue
                cp "$ICON_SRC"/apps/fcitx-skey.svg \
                   "$ICONS_BASE/$CURRENT_THEME/apps/$size/fcitx-skey.svg" 2>/dev/null || true
            done
            # Also copy scalable SVG for generic lookups
            mkdir -p "$ICONS_BASE/$CURRENT_THEME/scalable/apps" 2>/dev/null || true
            cp "$ICON_SRC"/apps/fcitx-skey.svg \
               "$ICONS_BASE/$CURRENT_THEME/scalable/apps/fcitx-skey.svg" 2>/dev/null || true
            echo "✓ Icon installed to theme: $CURRENT_THEME ($ICONS_BASE)"
            break
        fi
    done
fi

# Update GTK icon cache so GNOME Shell picks up new hicolor icons
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
    echo "✓ GTK icon cache updated"
fi

echo ""
echo "Done! skey is now the default Vietnamese input method."
echo "Toggle with Ctrl+Space."
echo ""

if [ "$ENV_NEEDS_FIX" = "1" ] && [ "$WRITE_ENV" != "1" ]; then
    echo "⚠  Environment variables were NOT configured (skipped)."
    echo "   Vietnamese input may not work in apps until you re-run"
    echo "   skey-setup and accept the prompt to write them."
    echo ""
fi

# Per-distro install / update instructions
case "$DISTRO" in
    fedora)
        echo "→ Install:  curl -fsSL https://collyn.github.io/skey/install-fedora.sh | sudo bash"
        echo "→ Or:       sudo dnf install fcitx5-skey"
        echo "→ Frontends: sudo dnf install fcitx5-gtk fcitx5-qt"
        ;;
    opensuse)
        echo "→ Install:  curl -fsSL https://collyn.github.io/skey/install-opensuse.sh | sudo bash"
        echo "→ Or:       sudo zypper install fcitx5-skey"
        echo "→ Frontends: sudo zypper install fcitx5-gtk"
        ;;
    arch)
        echo "→ Install:  curl -fsSL https://collyn.github.io/skey/install-arch.sh | sudo bash"
        echo "→ Or:       sudo pacman -S fcitx5-skey"
        echo "→ Frontends: sudo pacman -S fcitx5-gtk fcitx5-qt"
        ;;
    debian)
        echo "→ Install:  curl -fsSL https://collyn.github.io/skey/install.sh | sudo bash"
        echo "→ Or:       sudo apt install fcitx5-skey"
        echo "→ Frontends: sudo apt install fcitx5-frontend-gtk3 fcitx5-frontend-qt5 fcitx5-frontend-qt6"
        ;;
    void)
        echo "→ Frontends: sudo xbps-install -S fcitx5 fcitx5-gtk fcitx5-qt"
        echo "→ SKey: build from source; see https://github.com/collyn/skey"
        echo "→ Uinput: enable elogind/eudev active-seat ACL support on runit."
        ;;
    gentoo)
        echo "→ Frontends: sudo emerge --ask app-i18n/fcitx5 app-i18n/fcitx5-gtk app-i18n/fcitx5-qt"
        echo "→ SKey: build from source; see https://github.com/collyn/skey"
        echo "→ Uinput: enable elogind/udev active-seat ACL support on OpenRC."
        ;;
    nixos)
        echo "→ Configure i18n.inputMethod.type = \"fcitx5\" and fcitx5.addons in configuration.nix."
        echo "→ Enable services.fcitx5-skey for uinput access; see packaging/nixos/README.md."
        echo "→ Apply with sudo nixos-rebuild switch, then log out and back in."
        ;;
    *)
        echo "→ Install the fcitx5 GTK/Qt frontends using your distribution's package manager."
        echo "→ SKey source and packaging: https://github.com/collyn/skey"
        ;;
esac
echo ""
echo "  Settings GUI: fcitx5-skey-settings"
echo "  Logs:         tail -f /tmp/skey.log"
echo ""
echo "  Uinput access: getfacl /dev/uinput (active local desktop user)"
echo ""
if [ "$SESSION_TYPE" = "wayland" ]; then
    echo "⚠  Wayland note: If some apps still don't work after this,"
    echo "   log out and back in to fully refresh the session."
    echo ""
    echo "   The currently-focused app (e.g. this terminal) may not"
    echo "   accept Vietnamese input right away. Click away and back"
    echo "   — that forces a reconnect and fixes it."
fi
