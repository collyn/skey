#: src/settings/info_tab.cpp:509
msgid ""
"Không thể tự động cập nhật SKey trên NixOS.\n"
"\n"
"Hệ thống cần dùng flake với input tên là \"skey\".\n"
"Thêm vào /etc/nixos/flake.nix:\n"
"\n"
"  inputs.skey = {\n"
"    url = \"github:collyn/skey\";\n"
"    inputs.nixpkgs.follows = \"nixpkgs\";\n"
"  };\n"
"\n"
"Rồi chạy (cần quyền root):\n"
"\n"
"  cd /etc/nixos\n"
msgstr ""

#: src/settings/info_tab.cpp:522
msgid ""
"  # thêm vào configuration.nix:\n"
"  # services.fcitx5-skey.devVersion = \"%1\";\n"
"  sudo nix flake lock --override-input skey github:collyn/skey/v%1\n"
"  sudo nixos-rebuild switch --flake /etc/nixos\n"
"  fcitx5 -r -d\n"
"\n"
msgstr ""

#: src/settings/info_tab.cpp:531
msgid ""
"  sudo nix flake update skey\n"
"  sudo nixos-rebuild switch --flake /etc/nixos\n"
"  fcitx5 -r -d\n"
"\n"
msgstr ""

