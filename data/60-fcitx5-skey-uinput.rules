// Allow the owning user to restart their own fcitx5-skey-uinput-server
// instance without an admin password.
//
// The service runs as the dedicated unprivileged skey_uinput system user
// (created by sysusers.d; /dev/uinput access via the udev ACL rule).  The
// settings GUI and skey-setup call `systemctl try-restart
// fcitx5-skey-uinput-server@$USER.service`; without this rule that
// triggers a polkit password prompt (or fails silently).  Only the exact
// instance for the requesting user is whitelisted.
//
// `local && active` is the standard polkit idiom for "sitting at this
// machine's currently active session".  Do NOT reach for
// subject.isInSession(): it is not part of the polkit JS API — the only
// methods on Subject are isInGroup() and isInNetGroup() — and calling it
// throws a TypeError that aborts rule evaluation entirely, silently
// falling back to an admin password prompt.
//
// Only manage-units is granted.  `systemctl enable` uses the separate
// manage-unit-files action, for which systemd passes no "unit" detail
// (it operates on a list of files), so it cannot be scoped to a single
// unit — granting it would let any user enable any system unit.
// Enabling therefore stays a one-time root/sudo operation.
//
// reload-daemon is additionally granted: skey-setup runs
// `systemctl daemon-reload` before restarting so an updated unit file on
// disk takes effect (without it the restart would run the stale in-memory
// unit).  daemon-reload only re-reads root-owned unit files — it gives
// the user no ability to modify anything.
polkit.addRule(function (action, subject) {
    if (subject.local && subject.active) {
        if (action.id == "org.freedesktop.systemd1.reload-daemon") {
            return polkit.Result.YES;
        }
        if (action.id == "org.freedesktop.systemd1.manage-units") {
            var unit = action.lookup("unit");
            if (unit == "fcitx5-skey-uinput-server@" + subject.user + ".service") {
                return polkit.Result.YES;
            }
        }
    }
});
