[Unit]
Description=SKey uinput server for %i
Documentation=https://github.com/collyn/skey
After=systemd-udevd.service

[Service]
# Runs entirely unprivileged as the dedicated skey_uinput system user
# (created by the sysusers.d snippet).  /dev/uinput access comes from the
# udev ACL rule (99-skey-uinput.rules); the setfacl below is a belt-and-
# braces fallback for the case where the device node already existed
# before the rule was installed (e.g. uinput loaded early at boot).  The
# "+" prefix runs it in the root context of systemd, and the leading "-"
# makes a missing setfacl (no acl package) non-fatal so the service still
# starts and can fall back to the abstract socket.
#
# First ExecStartPre runs systemd-sysusers on every start so the unit is
# self-healing: package scriptlets (postinst/spec/PKGBUILD) create the
# user, but a plain `cmake --install` — or any install path without
# scriptlets — does not, and systemd then refuses to start the service
# with status=217/USER ("user cannot be resolved").  sysusers is
# idempotent, so re-running it is free.  The "-" prefix keeps NixOS
# working: /usr/bin/systemd-sysusers does not exist there, but the
# module creates the user declaratively anyway.
ExecStartPre=-+/usr/bin/systemd-sysusers /usr/lib/sysusers.d/skey-uinput.conf
ExecStartPre=-+/usr/bin/setfacl -m u:@SKEY_UINPUT_USER@:rw /dev/uinput

# CAP_SYS_PTRACE: the server verifies connecting clients by readlink of
# /proc/<pid>/exe — an unprivileged user cannot read another uid's exe
# link without this capability (the old root-run server could).  Scoped
# to this single process; a compromised server can already inject input
# via /dev/uinput, so this adds no meaningful new attack surface.
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE

# RuntimeDirectory creates /run/skey-uinput-%i owned by root:@SKEY_UINPUT_USER@
# with mode 0700: the server (group @SKEY_UINPUT_USER@) has write to bind the
# socket, everyone else is locked out.  ExecStartPost then grants traverse
# access to exactly ONE user — the instance's target user — via a named ACL
# (ACLs are checked at access time, so no group membership and no re-login
# is ever needed).  The socket inside is chmod 0666, but the directory ACL
# is the gate: only the target user, @SKEY_UINPUT_USER@ and root can reach
# it; other local users get EACCES before connect().  The "-" prefix keeps
# a missing setfacl non-fatal — the client then falls back to the legacy
# abstract socket.  RuntimeDirectoryPreserve=no cleans up the directory on
# stop — including the 0700 directory left behind by pre-0.x versions of
# the root-run server, which the new unprivileged server would otherwise
# be unable to write to.
RuntimeDirectory=skey-uinput-%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ExecStartPost=-+/usr/bin/setfacl -m u:%i:x /run/skey-uinput-%i

Type=simple
User=@SKEY_UINPUT_USER@
Group=@SKEY_UINPUT_USER@
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-skey-uinput-server %i
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
